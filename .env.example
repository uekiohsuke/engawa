# .env にコピーして使う（.env は git 管理外）

# LLM バックエンド：mock（LLMなしで動作確認）/ ollama
ENGAWA_LLM_BACKEND=mock
# Ollama のベースURL（OpenAI互換API /v1/chat/completions を使用）
ENGAWA_LLM_URL=http://192.168.0.178:11434
ENGAWA_LLM_MODEL=gemma4:12b
# 思考モード：none（思考なし・高速）/ low / medium / high。空にするとモデルの既定
ENGAWA_LLM_REASONING_EFFORT=none

# コアサーバー
ENGAWA_CORE_HOST=127.0.0.1
ENGAWA_CORE_PORT=8765

# 会話履歴DBなどの保存先
ENGAWA_DATA_DIR=data
# プロンプトに貼り付ける直近の会話履歴件数
ENGAWA_HISTORY_WINDOW=20
